# Build the normal image first; this image adds test dependencies and checks.
FROM sandbox-escape-finder:latest
USER 0:0
COPY requirements-test-lock.txt ./requirements-test-lock.txt
# Exercise the assignment's editable-install path as part of the build.
RUN pip install --no-cache-dir -c requirements-test-lock.txt -e ".[test]"
COPY tests ./tests
COPY validation ./validation
USER 65534:65534
# Docker-backend tests run from the host; this container has no Docker socket.
CMD ["python", "-m", "pytest", "-q", "-m", "not docker", "-p", "no:cacheprovider"]
